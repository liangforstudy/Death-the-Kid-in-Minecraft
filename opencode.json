{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "pendulum": {
      "type": "local",
      "command": ["node", "tools/pendulum-mcp-bridge.js"],
      "environment": {
        "PENDULUM_HOST": "127.0.0.1",
        "PENDULUM_PORT": "25566"
      },
      "timeout": 120000,
      "enabled": true
    }
  },
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "webfetch": "allow"
  }
}
